#include <stdio.h>
#include <string.h>

#define FILENAME "daily_goals.txt"

// Function to write goals to file
void writeGoals() {
    FILE *file;
    char goal[200];
    int  numGoals;

    file = fopen(FILENAME, "a");  // "a" = append mode (adds to existing data)

    if (file == NULL) {
        printf("Error: Could not open file for writing!\n");
        return;
    }

    printf("How many goals do you want to add? ");
    scanf("%d", &numGoals);
    getchar();  // clear newline from buffer

    for (int i = 0; i < numGoals; i++) {
        printf("Enter goal %d: ", i + 1);
        fgets(goal, sizeof(goal), stdin);
        goal[strcspn(goal, "\n")] = '\0';  // remove newline character
        fprintf(file, "- %s\n", goal);
    }

    fclose(file);  // always close file after use
    printf("Goals saved successfully!\n");
}

// Function to read and display goals from file
void readGoals() {
    FILE *file;
    char  line[200];

    file = fopen(FILENAME, "r");  // "r" = read mode

    if (file == NULL) {
        printf("No goals found! Add some goals first.\n");
        return;
    }

    printf("\n========================================\n");
    printf("           YOUR DAILY GOALS             \n");
    printf("========================================\n");

    while (fgets(line, sizeof(line), file) != NULL) {
        printf("%s", line);
    }

    printf("========================================\n");
    fclose(file);
}

// Main menu
int main() {
    int choice;

    do {
        printf("\n===== DAILY GOALS TRACKER =====\n");
        printf("1. Add Today's Goals\n");
        printf("2. View All Goals\n");
        printf("3. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: writeGoals();  break;
            case 2: readGoals();   break;
            case 3: printf("Goodbye! Stay productive!\n"); break;
            default: printf("Invalid choice!\n");
        }
    } while (choice != 3);

    return 0;
}

/*
FILE MODES EXPLANATION:
  "r"  -- Read mode        : Opens existing file for reading only.
  "w"  -- Write mode       : Creates new file / overwrites existing file.
  "a"  -- Append mode      : Opens file to add data at the end (no overwrite).
  "r+" -- Read+Write mode  : Opens existing file for both reading and writing.
  "w+" -- Write+Read mode  : Creates/overwrites file for read and write.

WHY "a" (append) is used here:
  -> Each time the user adds goals, they should be ADDED to existing goals.
  -> "w" mode would ERASE all previous goals.
  -> "a" mode safely adds new goals without losing old data.

SAMPLE OUTPUT:
  ===== DAILY GOALS TRACKER =====
  1. Add Today's Goals
  2. View All Goals
  3. Exit
