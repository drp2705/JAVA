// Approach 1: Check session manually in each controller method
@GetMapping("/events/create")
public String showCreateForm(HttpSession session, Model model) {
    if (session.getAttribute("loggedInStudent") == null) {
        return "redirect:/login";  // redirect unauthenticated users
    }
    model.addAttribute("event", new Event());
    return "createEvent";
}

// Approach 2: Use a HandlerInterceptor for centralized session checking
@Component
public class AuthInterceptor implements HandlerInterceptor {

    @Override
    public boolean preHandle(HttpServletRequest request,
                             HttpServletResponse response,
                             Object handler) throws Exception {

        HttpSession session = request.getSession(false);

        if (session == null || session.getAttribute("loggedInStudent") == null) {
            response.sendRedirect("/login");
            return false;  // block the request
        }
        return true;  // allow the request
    }
}

// Register interceptor in WebConfig:
@Configuration
public class WebConfig implements WebMvcConfigurer {

    @Autowired
    private AuthInterceptor authInterceptor;

    @Override
    public void addInterceptors(InterceptorRegistry registry) {
        registry.addInterceptor(authInterceptor)
                .addPathPatterns("/events/**", "/dashboard/**")
                .excludePathPatterns("/login", "/register", "/");
    }
}


